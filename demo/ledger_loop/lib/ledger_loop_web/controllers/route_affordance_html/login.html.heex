<Layouts.flash_group flash={@flash} />

<main class="route-affordance" aria-labelledby="login-title">
  <p><a href={~p"/"}>Back to LedgerLoop Workspace</a></p>

  <h1 id="login-title">Start Test Login</h1>
  <p>
    Relyra verifies SAML trust; LedgerLoop owns user mapping, session establishment, and authorization.
  </p>

  <div style="margin: 2rem 0;">
    <a href={"/fake_idp/#{@conn_id}/sso"} class="button button-primary">
      Simulate Login via FakeIdP
    </a>
  </div>

  <p>
    Optional external identity-provider proof is Phase 55 and is intentionally not started from this page.
  </p>
</main>
