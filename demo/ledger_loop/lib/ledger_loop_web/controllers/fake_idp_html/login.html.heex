<div class="max-w-2xl mx-auto mt-10">
  <div class="bg-yellow-100 border-l-4 border-yellow-500 text-yellow-700 p-4 mb-8" role="alert">
    <p class="font-bold">⚠️ Local Test Support / FakeIdP</p>
    <p>This is a local testing harness. It is not a legitimate production Identity Provider. It generates signed SAML responses to verify Relyra's strict rejection and acceptance paths.</p>
  </div>

  <div class="bg-white shadow overflow-hidden sm:rounded-lg">
    <div class="px-4 py-5 sm:px-6">
      <h3 class="text-lg leading-6 font-medium text-gray-900">
        Simulate SAML Login
      </h3>
      <p class="mt-1 max-w-2xl text-sm text-gray-500">
        Choose a scenario to post back to the Relyra ACS endpoint.
      </p>
    </div>
    
    <div class="border-t border-gray-200 px-4 py-5 sm:p-0">
      <form action="/fake_idp/sso" method="post" class="p-4 sm:px-6">
        <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
        <%= if @relay_state do %>
          <input type="hidden" name="RelayState" value={@relay_state} />
        <% end %>
        <%= if @in_response_to do %>
          <input type="hidden" name="in_response_to" value={@in_response_to} />
        <% end %>

        <div class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-gray-700">Action</label>
            <div class="mt-2 space-y-2">
              <div class="flex items-center">
                <input id="action-success" name="idp_action" type="radio" value="success" checked class="focus:ring-indigo-500 h-4 w-4 text-indigo-600 border-gray-300">
                <label for="action-success" class="ml-3 block text-sm font-medium text-gray-700">
                  Valid Login (sarah@northstar.example.com)
                </label>
              </div>
              <div class="flex items-center">
                <input id="action-failure" name="idp_action" type="radio" value="failure" class="focus:ring-indigo-500 h-4 w-4 text-indigo-600 border-gray-300">
                <label for="action-failure" class="ml-3 block text-sm font-medium text-gray-700">
                  Invalid Login (Tampered Signature)
                </label>
              </div>
            </div>
          </div>
          
          <div class="pt-5">
            <button type="submit" class="w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
              Submit SAML Response
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>
