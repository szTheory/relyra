{
  "realm": "relyra-adoption",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "users": [
    {
      "username": "adoption",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Adoption",
      "lastName": "Tester",
      "email": "adoption@example.com",
      "credentials": [
        {
          "type": "password",
          "value": "adoption-test-pass",
          "temporary": false
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "relyra-adoption-sp",
      "name": "Relyra Adoption SP",
      "enabled": true,
      "protocol": "saml",
      "fullScopeAllowed": true,
      "rootUrl": "http://demo-host.test",
      "baseUrl": "http://demo-host.test",
      "adminUrl": "http://demo-host.test/keycloak/acs",
      "redirectUris": ["http://demo-host.test/keycloak/acs"],
      "webOrigins": ["+"],
      "attributes": {
        "saml.authnstatement": "true",
        "saml.server.signature": "true",
        "saml.client.signature": "false",
        "saml.signature.algorithm": "RSA_SHA256",
        "saml.force.post.binding": "false",
        "saml.assertion.consumer.url.post": "http://demo-host.test/keycloak/acs",
        "saml_force_name_id_format": "urn:oasis:names:tc:SAML:1.1:nameid-format:emailAddress"
      }
    }
  ]
}
