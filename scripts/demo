#!/usr/bin/env bash

set -euo pipefail

usage() {
  echo "Usage: scripts/demo {doctor|up|reset|test|urls|down}" >&2
  exit 1
}

[[ $# -eq 1 ]] || usage

case "$1" in
  doctor)
    exec make doctor
    ;;
  up)
    exec make up-d
    ;;
  reset)
    exec make reset
    ;;
  test)
    exec make demo-test
    ;;
  urls)
    exec make url
    ;;
  down)
    exec make down
    ;;
  *)
    usage
    ;;
esac
