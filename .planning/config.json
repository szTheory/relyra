{
  "model_profile": "inherit",
  "runtime": "cursor",
  "model_profile_overrides": {
    "cursor": {
      "opus": "inherit",
      "sonnet": "composer-2.5-fast",
      "haiku": "composer-2.5-fast"
    }
  },
  "models": {
    "planning": "opus",
    "discuss": "opus",
    "research": "sonnet",
    "execution": "sonnet",
    "verification": "sonnet",
    "completion": "sonnet"
  },
  "model_overrides": {
    "gsd-codebase-mapper": "haiku",
    "gsd-roadmapper": "sonnet",
    "gsd-pattern-mapper": "sonnet",
    "gsd-executor": "sonnet",
    "gsd-code-reviewer": "sonnet",
    "gsd-code-fixer": "sonnet",
    "gsd-doc-classifier": "sonnet"
  },
  "commit_docs": true,
  "parallelization": true,
  "search_gitignored": false,
  "brave_search": false,
  "firecrawl": false,
  "exa_search": false,
  "git": {
    "branching_strategy": "none",
    "phase_branch_template": "gsd/phase-{phase}-{slug}",
    "milestone_branch_template": "gsd/{milestone}-{slug}",
    "quick_branch_template": null
  },
  "workflow": {
    "research": true,
    "plan_check": true,
    "verifier": true,
    "nyquist_validation": true,
    "auto_advance": false,
    "node_repair": true,
    "node_repair_budget": 2,
    "ui_phase": true,
    "ui_safety_gate": true,
    "text_mode": true,
    "research_before_questions": true,
    "discuss_mode": "assumptions",
    "skip_discuss": false,
    "code_review": true,
    "code_review_depth": "standard",
    "_auto_chain_active": false,
    "milestone_assessment": {
      "verify_lib_before_scope": true,
      "adopter_lens_default": true,
      "stop_milestone_includes_release_truth": true,
      "jtbd_refresh_at_milestone_close": true,
      "run_at_new_milestone": true,
      "prefer_repo_inspection_over_docs": true,
      "flag_conformance_manifest_drift": true,
      "no_auto_new_milestone": true
    },
    "milestone_next_step": {
      "adopter_lens": true,
      "parallel_repo_research": true,
      "retain_threads_and_retrospective": true,
      "prompts_dir": "prompts/",
      "path_to_done_thread": true
    },
    "test_command": "mix test --warnings-as-errors"
  },
  "hooks": {
    "context_warnings": true
  },
  "preferences": {
    "vendor_philosophy": "opinionated",
    "milestone_assessment_lens": "adopter_first_phoenix_saas",
    "research_style": "parallel_subagents",
    "investigations_retention": "threads_dir",
    "milestone_pause_when_done_enough": true,
    "demand_gated_requirements": [
      "AUTHN-POST-01",
      "KMS-01",
      "SIGNED-META-01"
    ],
    "adoption_truth_doc_wedge": true,
    "doc_ux_audit": {
      "forbid_planning_paths_in_extras": [
        "docs/jtbd_gap_map.md"
      ],
      "conformance_notes_adopter_facing": true
    }
  },
  "project_code": null,
  "phase_naming": "sequential",
  "agent_skills": {},
  "features": {},
  "mode": "yolo",
  "granularity": "standard"
}
