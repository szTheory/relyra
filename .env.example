# Relyra demo overrides are optional. The launcher and Compose defaults work
# without copying this file.

# Browser-facing loopback port for the solo Compose path.
# PORT=4000

# Browser-facing hostname for the shared proxy path.
# RELYRA_HOST=relyra.localhost

# Existing external network shared by Traefik-routed demos.
# DEMO_PROXY_NETWORK=proxy

# The following credentials are demo-only and not suitable for production.
# Leave the admin values empty to disable the mounted admin surface.
# DEMO_ADMIN_USERNAME=
# DEMO_ADMIN_PASSWORD=

# Optional seeded Keycloak demo-user password.
# KEYCLOAK_SARAH_PASSWORD=sarah-password
